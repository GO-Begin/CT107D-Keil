   1          #include <STC15F2K60S2.H>
   2          #include "MatrixKey.h"
   3          #include "Timer1.h"
   4          #include "Init.h"
   5          #include "Nixie.h"
   6          
   7          unsigned char T1cnt,i;          //i当作Nixie_Num的选择位，T1cnt计时触发几次中断
   8          unsigned char KeyNumber;        //KeyNumber当作Key()的返回值，即按下的键值
   9          
  10          /*用于数码管显示8位数字，默认第一二位显示0，其余不显示*/
  11          /*用#去除0位，确保数列位置与数码管位选一致*/
  12          unsigned char Nixie_Num[]={'#',0,0,10,10,10,10,10,10}; 
  13          
  14          void main()
  15          {
  16   1              /*进行定时器1及一系列初始化*/
  17   1              Timer1_Init();
  18   1              System_Init();
  19   1              
  20   1              while(1)
  21   1              {
  22   2                      KeyNumber=MatrixKey();  //KeyNumber实时读取Key()的返回键值
  23   2                      if(KeyNumber)
  24   2                      {
  25   3                              Nixie_Num[1]=KeyNumber/10;
  26   3                              Nixie_Num[2]=KeyNumber%10;
  27   3                      }
  28   2              }
  29   1      }
  30          
  31          void Timer1_Routine() interrupt 3
  32          {
  33   1              /*用于8位数码管显示*/
  34   1              i++;
  35   1              if(i>=9)
  36   1              i=1;            //跳过第一位'#'
  37   1              if(Nixie_Num[i]>='.')
  38   1                      Nixie(i,Nixie_Num[i]-'.',1); //小数点处理
  39   1              else
  40   1                      Nixie(i,Nixie_Num[i],0);
  41   1              
  42   1              /*设置调用Key_loop的频率*/
  43   1              T1cnt++;
  44   1              if(T1cnt>=20)   //20毫秒调用一次MatrixKey_loop检测键值
  45   1              {
  46   2                      T1cnt=0;        //T1计数器清零，用于下一次计数
  47   2                      MatrixKey_loop();
  48   2              }
  49   1      }


