  57          /*设置时钟初始值，参数为十进制，写入时要转为十六进制*/
  58          void RTC_Set(unsigned char *RTC_Buf)
  59          {
  60   1              Write_Ds1302_Byte(0x8E,0x00);
  61   1              Write_Ds1302_Byte(0x80,RTC_Buf[2]/10*16+RTC_Buf[2]%10);//提取十进制的十位和个位，十位*16+�
             -�位得到对应十六进制数
  62   1              Write_Ds1302_Byte(0x82,RTC_Buf[1]/10*16+RTC_Buf[1]%10);
  63   1              Write_Ds1302_Byte(0x84,RTC_Buf[0]/10*16+RTC_Buf[0]%10);
  64   1      }
  65          
  66          /*读取时钟现在的值，读取为十六进制，要转为十进制*/
  67          void RTC_Read(unsigned char *RTC_Buf)
  68          {
  69   1              RTC_Buf[2]=Read_Ds1302_Byte(0x81)/16*10+Read_Ds1302_Byte(0x81)%16;//提取十六进制的十位和个位�
             -��十位*10+个位得到对应十进制
  70   1              RTC_Buf[1]=Read_Ds1302_Byte(0x83)/16*10+Read_Ds1302_Byte(0x83)%16;
  71   1              RTC_Buf[0]=Read_Ds1302_Byte(0x85)/16*10+Read_Ds1302_Byte(0x85)%16;
  72   1      }


