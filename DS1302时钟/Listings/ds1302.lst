   1          #include <STC15F2K60S2.H>
   2          #include "INTRINS.h"
   3          
   4          /*SCK为时钟线，SDA为数据线，RST为开始写入的标志*/
   5          sbit SCK=P1^7;
   6          sbit SDA=P2^3;
   7          sbit RST=P1^3;
   8          
   9          /*写入的基础操作，用于后续封装*/
  10          void Write_Ds1302(unsigned  char temp) 
  11          {
  12   1              unsigned char i;
  13   1              for (i=0;i<8;i++)       
  14   1              { 
  15   2                      SCK = 0;
  16   2                      SDA = temp&0x01;
  17   2                      temp>>=1; 
  18   2                      SCK=1;
  19   2              }
  20   1      }   
  21          
  22          /*对某个地址写入*/
  23          void Write_Ds1302_Byte( unsigned char address,unsigned char dat )     
  24          {
  25   1              RST=0;  _nop_();
  26   1              SCK=0;  _nop_();
  27   1              RST=1;  _nop_();  
  28   1              Write_Ds1302(address);  
  29   1              Write_Ds1302(dat);              
  30   1              RST=0; 
  31   1      }
  32          
  33          /*读取某个地址的值*/
  34          unsigned char Read_Ds1302_Byte ( unsigned char address )
  35          {
  36   1              unsigned char i,temp=0x00;
  37   1              RST=0;  _nop_();
  38   1              SCK=0;  _nop_();
  39   1              RST=1;  _nop_();
  40   1              Write_Ds1302(address);
  41   1              for (i=0;i<8;i++)       
  42   1              {               
  43   2                      SCK=0;
  44   2                      temp>>=1;       
  45   2                      if(SDA)
  46   2                      temp|=0x80;     
  47   2                      SCK=1;
  48   2              } 
  49   1              RST=0;  _nop_();
  50   1              SCK=0;  _nop_();
  51   1              SCK=1;  _nop_();
  52   1              SDA=0;  _nop_();
  53   1              SDA=1;  _nop_();
  54   1              return (temp);                  
