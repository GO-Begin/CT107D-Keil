   1          #include <STC15F2K60S2.H>
   2          #include "OneWire.h"
   3          
   4          /*声明温度二进制的高八位与低八位*/
   5          unsigned char High,Low;
   6          
   7          /*读取DS18B20的温度数据*/
   8          float Temperature_Read()
   9          {
  10   1              /*DS18B20开始监测温度*/
  11   1              init_ds18b20();
  12   1              Write_DS18B20(0xCC);
  13   1              Write_DS18B20(0x44);
  14   1              
  15   1              /*读取DS18B20的数据，存入High与Low*/
  16   1              init_ds18b20();
  17   1              Write_DS18B20(0xCC);
  18   1              Write_DS18B20(0xBE);
  19   1      
  20   1              Low=Read_DS18B20();
  21   1              High=Read_DS18B20();
  22   1              
  23   1              /*返回DS18B20的数据，并转化成真实温度*/
  24   1              return (High<<8|Low)*0.0625f;
  25   1      }


